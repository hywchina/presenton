# The model id must match `curl http://127.0.0.1:18081/v1/models` exactly.
QWEN3_VL_MODEL=qwen3-vl-8b-instruct
QWEN3_VL_BASE_URL=http://host.docker.internal:18081/v1
QWEN3_VL_API_KEY=rail-vllm-test-key
QWEN3_VL_MAX_OUTPUT_TOKENS=2048
ICON_SEARCH_MODE=lexical

# Keep the public API unauthenticated only on a trusted loopback/private machine.
DISABLE_AUTH=true
PRESENTON_HTTP_HOST_PORT=5001
